HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# PostgreSQL connection string; endpoint data is stored in memory when omitted.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set all three values in Railway to protect operational APIs with Authentik OIDC.
AUTH_REQUIRED=true
OIDC_ISSUER=https://auth.example.com/application/o/operation-backend
OIDC_AUDIENCE=operation-backend
# Comma-separated browser origins permitted to call this API.
CORS_ORIGIN=https://app.example.com
