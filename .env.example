HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# PostgreSQL connection string; endpoint data is stored in memory when omitted.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Login (POST /v1/login, the users table). AUTH_REQUIRED stops the service at startup if the secret is missing.
AUTH_REQUIRED=true
AUTH_JWT_SECRET=
# Comma-separated browser origins permitted to call this API.
CORS_ORIGIN=https://app.example.com
# Love Kingdom's key for GET /v1/availability (X-Api-Key header); the same value as legacy's B2C_API_KEY.
B2C_API_KEY=
