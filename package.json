{
  "name": "operation-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify web application scaffold",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --import ./test/setup.ts --test --test-concurrency=3 test/**/*.test.ts",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "db:migrate": "tsx src/migrate.ts",
    "seed:routes": "tsx src/tools/seed-routes.ts",
    "seed:boats": "tsx src/tools/seed-boats.ts",
    "import:users": "tsx src/tools/import-users.ts",
    "user:create": "tsx src/tools/create-user.ts",
    "import:contracts": "tsx src/tools/import-contracts.ts",
    "import:attachments": "tsx src/tools/import-attachments.ts",
    "import:fleet-stock": "tsx src/tools/import-fleet-stock.ts",
    "import:pier-office": "tsx src/tools/import-pier-office.ts",
    "import:fleet": "tsx src/tools/import-fleet.ts",
    "import:costing": "tsx src/tools/import-costing.ts",
    "verify:import": "tsx src/tools/verify-import.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^8.1.1",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.2.1",
    "jose": "^6.2.10",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
